<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_coa" model="ir.ui.view">
        <field name="name">account.payment.form.coa.direct.print</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- ① Print buttons in header -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_coa_print_receipt"
                        type="object"
                        string="طباعة إيصال"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="state not in ('in_process', 'paid')"/>
                <button name="action_coa_print_statement"
                        type="object"
                        string="كشف حساب"
                        icon="fa-list-alt"
                        class="btn-secondary"
                        invisible="not partner_id or payment_type == 'transfer'"/>
            </xpath>

            <!-- ② Balance before/after inside group2 (right column) -->
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="coa_balance_before"
                       readonly="1"
                       widget="monetary"
                       string="الرصيد قبل الدفعة"
                       options="{'currency_field': 'currency_id'}"
                       invisible="not partner_id or payment_type == 'transfer'"/>
                <field name="coa_balance_after"
                       readonly="1"
                       widget="monetary"
                       string="الرصيد بعد الدفعة"
                       options="{'currency_field': 'currency_id'}"
                       invisible="not partner_id or payment_type == 'transfer'"/>
            </xpath>

        </field>
    </record>

</odoo>
