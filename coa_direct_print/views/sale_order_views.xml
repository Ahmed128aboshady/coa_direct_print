<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_direct_print" model="ir.ui.view">
        <field name="name">sale.order.form.coa.direct.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_coa_print_order"
                        type="object"
                        string="Print Order"
                        icon="fa-print"
                        class="btn-secondary"/>
                <button name="action_coa_print_invoice"
                        type="object"
                        string="Print Invoice"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="invoice_count == 0"/>
                <button name="action_coa_print_statement"
                        type="object"
                        string="Customer Statement"
                        icon="fa-print"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

</odoo>
