<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_direct_print" model="ir.ui.view">
        <field name="name">account.move.form.coa.direct.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_coa_print_invoice"
                        type="object"
                        string="Direct Print"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
                <button name="action_coa_print_statement"
                        type="object"
                        string="Customer Statement"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
